# Copia este archivo a ".env" y cambia los valores. ".env" NO se sube a Git.
# Usa contraseñas solo con letras y números (van dentro de URLs de conexión).
POSTGRES_USER=canchas
POSTGRES_PASSWORD=cambia-esto-por-letras-y-numeros
POSTGRES_DB=canchas
MONGO_USER=canchas
MONGO_PASSWORD=cambia-esto-por-letras-y-numeros
# Mínimo 32 caracteres. Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
